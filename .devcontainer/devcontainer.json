{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "web/app.js"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "python scripts/build_data.py && python -m http.server 8000 -d web"
  },
  "portsAttributes": {
    "8000": { "label": "Application", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8000]
}
